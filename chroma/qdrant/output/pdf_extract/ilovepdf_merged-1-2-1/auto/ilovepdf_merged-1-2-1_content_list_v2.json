                        "type": "equation_inline",
                        "content": "\\left( \\begin{array} { c c } { { - 1 + \\lambda } } & { { 1 + \\lambda } } \\\\ { { \\lambda ( 1 - \\lambda ) } } & { { \\lambda } } \\end{array} \\right)"
